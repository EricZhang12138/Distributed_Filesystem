                </mxCell>
                <mxCell id="p3_cat4" value="&lt;b&gt;ROUTING&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px;color:#666&#39;&gt;Look up tree, return data server&lt;br&gt;address + root to client.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;container=1;collapsible=0;strokeWidth=2;" parent="1" vertex="1">
