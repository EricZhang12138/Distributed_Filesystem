                    <mxGeometry x="10" y="70" width="230" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p3_rmdir" value="&lt;b&gt;rmdir&lt;/b&gt; &amp;mdash; remove dir node, forward to all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="p3_cat2" vertex="1">
                    <mxGeometry x="10" y="110" width="230" height="30" as="geometry"/>
                </mxCell>
