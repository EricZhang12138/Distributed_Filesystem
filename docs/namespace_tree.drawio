                <mxCell id="p4_s12" value="&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;12.&lt;/b&gt; open(&amp;quot;file2.txt&amp;quot;, root+&amp;quot;/&amp;quot;)&lt;/font&gt;" style="html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" edge="1">
